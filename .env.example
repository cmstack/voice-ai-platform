# --- Environment ---
# "production" makes the voice engine refuse to start with known default secrets or unsafe settings.
APP_ENV="development"

# --- Database (local Supabase CLI: `supabase start` prints these) ---
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-local-anon-key"
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
NEXT_PUBLIC_VOICE_ENGINE_URL="http://localhost:8000"

# --- AWS Bedrock (Nova 2.5 Sonic + Claude) ---
# Credentials come from the AWS CLI chain (~/.aws, `aws configure` / `aws sso login`).
# Set AWS_PROFILE to use a named profile; leave empty for the default profile.
AWS_PROFILE=""
# Optional explicit override (takes precedence over the profile):
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_SESSION_TOKEN=""
AWS_REGION="us-east-1"
NOVA_SONIC_MODEL_ID="amazon.nova-2-5-sonic"
BEDROCK_CLAUDE_MODEL_ID="anthropic.claude-opus-5-5"

# --- Telephony (Twilio; use webrtc_only for $0 browser-only dev) ---
TELEPHONY_PROVIDER="webrtc_only" # "twilio" | "webrtc_only"
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."
PUBLIC_VOICE_WEBHOOK_BASE_URL="https://your-tunnel.ngrok-free.app"
VALIDATE_TWILIO_SIGNATURE="true"
VALIDATE_TWILIO_WS_SIGNATURE="true"

# --- Outbound dialing guard ---
ALLOWED_DIAL_COUNTRY_CODES='["1"]'   # E.164 country codes; "1" = US/Canada
REQUIRE_DIAL_CONSENT="true"           # never auto-dial a contact without recorded consent
MAX_DIALS_PER_NUMBER_PER_DAY="3"
MAX_DIALS_PER_HOUR="30"

# --- API rate limits ---
LEADS_PER_MINUTE="30"
WEBRTC_OFFERS_PER_MINUTE="6"
MAX_CONCURRENT_BROWSER_CALLS="3"

# --- Calendar ---
CAL_API_KEY="cal_live_..."

# --- Lead webhook (external forms call POST /api/leads with X-Webhook-Secret) ---
# Use 24+ random characters, e.g. `openssl rand -hex 24`. Placeholders like "change-me" are treated as unset.
LEAD_WEBHOOK_SECRET="change-me"
